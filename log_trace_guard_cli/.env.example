# ── LLM API 配置 ──
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://raytoken.com.cn/v1
LLM_MODEL_NAME=deepseek-v4-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=30
LLM_MAX_TOKENS=2048

# ── RAG 配置 ──
# embedding 模型（用于向量化规则数据）
EMBEDDING_MODEL=text-embedding-3-small
# 向量缓存文件路径（相对 ~/.log-guard/）
VECTOR_CACHE_FILE=rule_vector_cache.json
# 知识库检索 Top-K
RAG_TOP_K=5
# 相似度阈值（低于此值不返回结果）
RAG_SIMILARITY_THRESHOLD=0.60

# ── 意图识别配置 ──
# 意图分类置信度阈值（低于此值走通用问答）
INTENT_CONFIDENCE_THRESHOLD=0.40

# ── 对话配置 ──
# 最大上下文轮数
MAX_CONTEXT_TURNS=20
# 对话日志保存目录（相对 ~/.log-guard/）
CHAT_LOG_DIR=chat_logs