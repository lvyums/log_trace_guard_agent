{
  "rules": [
    {
      "id": "CHAIN-SSH-001",
      "name": "SSH暴力破解",
      "description": "检测SSH暴力破解攻击链：多次认证失败 → 最终成功登录",
      "risk_level": "P2_高危",
      "min_events": 2,
      "max_time_window_minutes": 10,
      "suggestion": "立即封禁源IP，启用fail2ban，强制密钥认证",
      "stages": [
        {
          "device_type": "ssh",
          "status": "failed",
          "min_count": 3,
          "label": "多次SSH认证失败"
        },
        {
          "device_type": "ssh",
          "status": "success",
          "label": "SSH登录成功"
        }
      ]
    },
    {
      "id": "CHAIN-SSH-002",
      "name": "SSH暴力破解（仅失败）",
      "description": "检测SSH暴力破解：短时间大量失败尝试",
      "risk_level": "P2_高危",
      "min_events": 5,
      "max_time_window_minutes": 5,
      "suggestion": "检查是否存在暴力破解，考虑封禁源IP",
      "stages": [
        {
          "device_type": "ssh",
          "status": "failed",
          "min_count": 5,
          "label": "大量SSH认证失败"
        }
      ]
    },
    {
      "id": "CHAIN-DEF-001",
      "name": "防火墙拦截链",
      "description": "检测防火墙持续拦截：大量drop → rejected，可能为扫描或攻击",
      "risk_level": "P2_高危",
      "min_events": 3,
      "max_time_window_minutes": 5,
      "suggestion": "检查源IP是否为恶意扫描，考虑永久封禁",
      "stages": [
        {
          "device_type": "firewall",
          "status": "dropped",
          "min_count": 3,
          "label": "防火墙丢弃流量"
        },
        {
          "device_type": "firewall",
          "status_startswith": "reject",
          "min_count": 2,
          "label": "防火墙拒绝连接"
        }
      ]
    },
    {
      "id": "CHAIN-WEB-001",
      "name": "Web攻击→数据库入侵",
      "description": "检测Web攻击到数据库入侵链：WAF拦截 → Web异常 → 数据库错误",
      "risk_level": "P1_中危",
      "min_events": 2,
      "max_time_window_minutes": 10,
      "suggestion": "检查SQL注入攻击，审计数据库操作日志",
      "stages": [
        {
          "device_type": "waf",
          "status": "blocked",
          "attack_type": "sql",
          "label": "WAF拦截SQL注入"
        },
        {
          "device_type": "web",
          "status_startswith": "5",
          "label": "Web服务器5xx错误"
        },
        {
          "device_type": "db",
          "status": "error",
          "label": "数据库错误"
        }
      ]
    },
    {
      "id": "CHAIN-DB-001",
      "name": "数据库连接失败链",
      "description": "检测数据库连接失败关联链：连接失败 → 重试 → 最终超时",
      "risk_level": "P1_中危",
      "min_events": 2,
      "max_time_window_minutes": 5,
      "suggestion": "检查数据库服务状态和连接池配置",
      "stages": [
        {
          "device_type": "db",
          "status": "error",
          "label": "数据库连接失败"
        },
        {
          "device_type": "db",
          "status": "timeout",
          "label": "数据库超时"
        }
      ]
    },
    {
      "id": "CHAIN-AUTH-001",
      "name": "认证失败→访问拒绝",
      "description": "检测认证失败关联链：多次认证失败 → 账户锁定 → 访问拒绝",
      "risk_level": "P2_高危",
      "min_events": 2,
      "max_time_window_minutes": 5,
      "suggestion": "检查账户安全策略，启用多因素认证",
      "stages": [
        {
          "device_type": "auth",
          "status": "failed",
          "min_count": 3,
          "label": "多次认证失败"
        },
        {
          "device_type": "auth",
          "status_startswith": "denied",
          "label": "访问被拒绝"
        }
      ]
    },
    {
      "id": "CHAIN-NET-001",
      "name": "网络超时级联链",
      "description": "检测网络超时关联链：重试 → 超时 → 服务降级",
      "risk_level": "P2_高危",
      "min_events": 2,
      "max_time_window_minutes": 3,
      "suggestion": "检查网络连通性和下游服务健康状态",
      "stages": [
        {
          "device_type": "network",
          "status_startswith": "timeout",
          "label": "网络超时"
        },
        {
          "device_type": "network",
          "status": "error",
          "label": "网络错误"
        }
      ]
    }
  ]
}
