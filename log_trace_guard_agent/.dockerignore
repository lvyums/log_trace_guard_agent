# ============================================================
# Docker 构建上下文排除 — 减少镜像体积 + 避免密钥/缓存泄漏
# ============================================================

# 代码/数据
.git
.gitignore
.github

# 运行数据(挂载卷,不进镜像)
data/chroma_db
data/chroma_db_test*
data/upload_temp
logs
*.log

# 密钥与环境变量(绝不进镜像)
.env
.env.*
!.env.example

# 前端构建中间产物(源码需要,node_modules 不需要)
frontend/node_modules
frontend/dist

# 测试与文档
tests
test_*.py
docs
*.md
!README.md

# Python 缓存
__pycache__
*.pyc
.pytest_cache
*.egg-info

# 开发环境
venv
.venv
.idea
.vscode
.claude
