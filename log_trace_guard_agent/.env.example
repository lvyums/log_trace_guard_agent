# ── 服务配置 ──
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# ── LLM 配置（必填：LLM_API_KEY） ──
# 从管理员获取 API Key 后在此填写
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://raytoken.com.cn/v1
LLM_MODEL_NAME=deepseek-v4-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=10
LLM_RETRY_COUNT=1

# ── Embedding & Reranker ──
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-large
CHROMA_DB_PATH=./data/chroma_db
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.6

# ── 日志解析 ──
MAX_LOG_LENGTH=10000
MAX_BATCH_SIZE=100
LOG_CLEAN_SYSLOG=true

# ── 文件上传 ──
MAX_UPLOAD_SIZE_MB=10
UPLOAD_TEMP_DIR=./data/upload_temp
ALLOWED_EXTENSIONS='[".txt",".csv",".log"]'

# ── 风险研判 ──
RISK_CONFIDENCE_HIGH=0.85
RISK_CONFIDENCE_MEDIUM=0.70
RISK_CONFIDENCE_LOW=0.50

# ── Splunk 配置 ──
# SPLUNK_BASE_URL=https://splunk.company.com
# SPLUNK_USERNAME=admin
# SPLUNK_PASSWORD=your_password
# SPLUNK_AUTH_TOKEN=your_token
# SPLUNK_VERIFY_SSL=true
# SPLUNK_SEARCH_TIMEOUT=30
# SPLUNK_MAX_RESULTS=100

# ── ES 配置 ──
# ES_BASE_URL=http://localhost:9200
# ES_USERNAME=elastic
# ES_PASSWORD=your_password
# ES_VERIFY_SSL=true
# ES_SEARCH_TIMEOUT=30
# ES_MAX_RESULTS=100

# ── 规则引擎 ──
RULE_DATA_DIR=./data/rule_data
